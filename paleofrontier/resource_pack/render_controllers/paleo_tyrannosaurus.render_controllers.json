{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.paleo_tyrannosaurus": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.wild",
            "Texture.bonded",
            "Texture.alert",
            "Texture.tagged"
          ]
        },
        "geometries": {
          "Array.models": [
            "Geometry.default",
            "Geometry.baby"
          ]
        }
      },
      "geometry": "query.is_baby ? Array.models[1] : Array.models[0]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.mark_variant == 1 ? 3 : query.variant]"
      ]
    }
  }
}
